    "1:1 코칭" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:1"
          }
        }
      }
    },
    "1:1·1:2 코치더코치는 %@만 인정돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:1 and 1:2 coach-the-coach only counts for %@."
          }
        }
      }
    },
    "1:1·1:2 코치더코치는 실제 시간의 2배(%lld분)로 기록돼요. 1시간이면 120분이라 최대 1시간까지만 적을 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:1 and 1:2 coach-the-coach sessions are logged at twice the actual time (%lld min). One hour becomes 120 minutes, so you can log up to one hour."
          }
        }
      }
    },
    "1:2 (2배 인정)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:2 (counts double)"
          }
        }
      }
    },
    "A 날짜 · B 시간" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Column A: Date · Column B: Time"
          }
        }
      }
    },
    "B 시간: 종료 시각이 시작 시각보다 늦어야 해요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B Time: the end must be later than the start"
          }
        }
      }
    },
    "C 고객명: %lld명의 이름이 필요해요" : {
      "localizations" : {
