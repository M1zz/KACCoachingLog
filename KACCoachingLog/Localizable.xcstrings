            "value" : "%lld min"
          }
        }
      }
    },
    "%lld분 미만 코칭은 인정되지 않아요. 실제 시간을 확인하거나 이 기록을 삭제해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions under %lld minutes don't count. Check the actual time or delete this record."
          }
        }
      }
    },
    "%lld분 미만 코칭은 코칭일지에 인정되지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
