    "%@ 코치 · 코치더코치" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach %@ · Coach-the-coach"
          }
        }
      }
    },
    "%@ 필요 시간" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ required hours"
          }
        }
      }
    },
    "%@: %lld분이에요. %@ 시간을 확인하거나 이 기록을 삭제해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$lld min. %3$@ Check the time or delete this record."
          }
        }
      }
    },
    "%@: %lld분이에요. %@ 종료 시각을 줄여 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$lld min. %3$@ Set an earlier end time."
          }
        }
      }
    },
    "%@: ICF 그룹코칭은 최대 %lld명까지예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ICF group coaching allows up to %2$lld people."
          }
        }
      }
    },
    "%@: 고객명이 비어 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the client name is missing."
          }
        }
      }
    },
    "%@: 그룹 코치더코치는 응시자 3-5명 구성이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: group coach-the-coach needs 3 to 5 candidates."
          }
        }
      }
    },
    "%@: 그룹코칭은 고객명을 3명(3인 미만이면 전원)까지 적어야 해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: group coaching needs up to 3 client names (all of them if fewer than 3)."
          }
        }
      }
    },
    "%@: 그룹코칭은 최대 1:9(총 9명)까지만 작성할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: group coaching can be logged for up to 1:9 (9 people)."
          }
        }
      }
    },
    "%@: 날짜를 넘기는 세션이에요. 날짜별로 나눠 적는 것이 안전해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: this session runs past midnight. It's safer to split it by date."
          }
        }
      }
    },
    "%@: 받은 코치더코치는 ICF 코칭 로그 시간에 포함되지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: coach-the-coach received doesn't count toward ICF coaching log hours."
          }
        }
      }
    },
    "%@: 분은 %lld분으로 적었지만 시간 범위가 %lld분이에요. 시간 범위도 %@ 안이어야 해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$lld min was entered, but the time range is %3$lld min. The time range must also be within %4$@."
          }
        }
      }
    },
    "%@: 자격번호 형식(예: KPC00000)을 확인해 주세요. 한국코치협회 인증 코치만 인정돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: check the certification number format (e.g. KPC00000). Only KCA-certified coaches count."
          }
        }
      }
    },
    "%@: 적은 시간(%lld분)이 시간 범위(%lld분)와 달라요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the minutes entered (%2$lld) differ from the time range (%3$lld min)."
          }
        }
      }
    },
    "%@: 적은 시간이 시간 범위×%lld배와 달라요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: the minutes entered differ from the time range × %2$lld."
          }
        }
      }
    },
    "%@: 종료 시각이 시작 시각보다 늦어야 해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the end time must be after the start time."
          }
        }
      }
    },
    "%@: 코치더코치 코치의 인증자격번호가 비어 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the coach-the-coach coach's certification number is missing."
          }
        }
      }
    },
    "%@: 코치더코치를 해준 코치 이름이 비어 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the coach-the-coach coach's name is missing."
          }
        }
      }
    },
    "%@: 코칭 시간(분)이 비어 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the coaching minutes are missing."
          }
        }
      }
    },
    "%@는 최소 %lld명 이상의 고객이 필요해요. (현재 %lld명)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ requires at least %2$lld clients. (Now %3$lld)"
          }
        }
      }
    },
    "%@에 %@ 님 코칭 합계가 %lld분이에요. 하루 2회 합산 최대 120분이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: sessions with %2$@ total %3$lld min. Two sessions a day can total at most 120 min."
          }
        }
      }
    },
    "%@에 %@ 님 코칭이 %lld회예요. 같은 날 동일인은 2회까지만 인정돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %3$lld sessions with %2$@. Only 2 sessions per client per day count."
          }
        }
      }
    },
    "%lld~%lld분" : {
